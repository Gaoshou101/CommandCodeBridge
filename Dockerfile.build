FROM golang:1.26-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG REPOSITORY="https://github.com/Gaoshou101/CommandCodeBridge"
RUN mkdir /out && CGO_ENABLED=1 go build -trimpath -buildvcs=false -buildmode=c-shared \
    -ldflags="-s -w -X 'commandcodebridge/internal/bridge.Repository=${REPOSITORY}'" \
    -o /out/commandcodebridge.so ./cmd/commandcodebridge

FROM scratch AS artifact
COPY --from=build /out/commandcodebridge.so /
