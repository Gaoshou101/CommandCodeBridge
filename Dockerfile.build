FROM golang:1.26-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN test -f /src/internal/bridge/panel-assets/management.html.gz
ARG REPOSITORY="https://github.com/Gaoshou101/CommandCodeBridge"
RUN mkdir /out && CGO_ENABLED=1 go build -trimpath -buildvcs=false -buildmode=c-shared \
    -ldflags="-s -w -X 'commandcodebridge/internal/bridge.Repository=${REPOSITORY}'" \
    -o /out/commandcodebridge.so ./cmd/commandcodebridge
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/commandcodebridge-login ./cmd/commandcodebridge-login

FROM scratch AS artifact
COPY --from=build /out/commandcodebridge.so /
COPY --from=build /out/commandcodebridge-login /
